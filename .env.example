# BetPlus backend environment
# Copy to .env and adjust. Never commit real secrets.

# development | staging | production | test
ENVIRONMENT=development

# Local development (SQLite). Production MUST use PostgreSQL.
DATABASE_URL=sqlite:///./betplus.db

# Supabase / Heroku Postgres examples:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# postgres:// URLs from Heroku are normalized automatically.

# JWT signing secret. REQUIRED and must be unique in staging/production.
SECRET_KEY=dev-insecure-key-set-SECRET_KEY-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins. Never use * in production.
CORS_ORIGINS=http://localhost:3000

# Seed sports/matches. Ignored in production unless ALLOW_DEMO_SEED=true.
SEED_DEMO_DATA=true
# Demo users (admin@betplus.com / admin123) — always disabled in production.
SEED_DEMO_USERS=true
ALLOW_DEMO_SEED=false

# Heroku sets PORT automatically.
PORT=8000

RATE_LIMIT_ENABLED=true
SETTLEMENT_POLL_SECONDS=10

# simulated | moolre | disabled
# simulated auto-completes deposits server-side. NOT real money.
PAYMENTS_MODE=moolre
ALLOW_SIMULATED_PAYMENTS=false
PAYMENT_CURRENCY=GHS

# Moolre (required when PAYMENTS_MODE=moolre). Backend-only — never NEXT_PUBLIC_*.
MOOLRE_ENV=sandbox
MOOLRE_API_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=your-moolre-username
MOOLRE_PUBLIC_KEY=your-moolre-public-key
MOOLRE_API_KEY=your-moolre-private-key
MOOLRE_ACCOUNT_NUMBER=your-moolre-account-number
MOOLRE_WEBHOOK_SECRET=your-moolre-callback-secret
# Public HTTPS URL of POST /api/v1/payments/webhook (configured in the Moolre dashboard).
MOOLRE_CALLBACK_URL=https://api.example.com/api/v1/payments/webhook

# Direct blockchain crypto deposits (BTC, USDT TRC20, USDT ERC20).
# Backend-only: match the deposit to a unique backend-assigned address,
# then verify the on-chain transaction before crediting the wallet.


# Legacy compatibility for NOWPayments. This path is deprecated for BTC/USDT deposits.
# Leave disabled unless a legacy migration requires it.
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_BASE_URL=https://api.sandbox.nowpayments.io
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://api.example.com/api/v1/payments/webhooks/nowpayments
NOWPAYMENTS_PRICE_CURRENCY=GHS

# Optional PostgreSQL concurrency tests:
# POSTGRES_TEST_URL=postgresql://postgres:postgres@localhost:5432/betplus_test

# One-shot only: drop leftover unversioned tables so Alembic can create the
# production schema. Unset immediately after a successful `alembic upgrade head`.
# ALLOW_SCHEMA_RESET=false